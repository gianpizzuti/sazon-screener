# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# SCREENER_CLIENT_CONFIG=config/clients/grupo_sazon
# SCREENER_DATABASE_URL=sqlite:///data/screener.db

# Demo-only tools (simulated clock to show follow-ups). `make run` turns them on; never in production.
# SCREENER_DEMO_TOOLS=1

# Optional: Sofía's voice in "Try the agent" → Voice (ADR 0011). Without it, the browser's voice is used.
ELEVENLABS_API_KEY=
